    {
      "title": "Reading this dashboard",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "Start with **Monitoring health**. An up Collector can serve an empty scrape, and older application series expire when exports stop. **Last request age** grows during quiet periods. Use source presence and target status separately. Click a data point to open sanitized logs for the selected time range."
      },
      "gridPos": {
        "w": 24,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
