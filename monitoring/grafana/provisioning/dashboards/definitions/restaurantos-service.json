        "type": "prometheus",
        "uid": "restaurantos-prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/s",
          "noValue": "Unavailable",
          "links": [
