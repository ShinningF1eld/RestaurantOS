# Local-development database URL. These are Docker Compose defaults only.
# Do not reuse these credentials outside a local development environment.
DATABASE_URL=postgresql+asyncpg://restaurantos:restaurantos@localhost:5433/restaurantos  # pragma: allowlist secret
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_ECHO=false
# Optional API/worker telemetry; never a /health or /ready dependency.
MONITORING_ENABLED=false
# Operator-only PostgreSQL aggregates; enable on one API process per stack.
MONITORING_BUSINESS_AGGREGATES_ENABLED=false
MONITORING_BUSINESS_COLLECTION_SECONDS=30
# Enable amounts only after verifying all retained prices use THB.
MONITORING_BUSINESS_SALES_THB=false
# Optional bounded process-metric slot (0–31); distinct for concurrent workers.
# Without a slot, worker traces/durable gauges remain enabled; local metrics do not.
# MONITORING_WORKER_SLOT=0
MONITORING_ENDPOINT=http://localhost:4318
MONITORING_TRUSTED_UPSTREAM_IPS=[]
MONITORING_EXPORT_TIMEOUT_SECONDS=1
MONITORING_EXPORT_INTERVAL_MS=5000
MONITORING_QUEUE_SIZE=256
MONITORING_SHUTDOWN_SECONDS=3
# Slow cursor-operation threshold in seconds (0.001–60).
MONITORING_SQL_SLOW_SECONDS=0.5
# Defaults preserve ordinary host development; the gateway rehearsal uses 5/0/5.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
# Optional infrastructure; startup and /health do not require Redis availability.
REDIS_URL=redis://localhost:6379/0
REDIS_OPERATION_BUDGET_MS=100
REDIS_MAX_CONNECTIONS=20
# Validation overrides this with a unique owned run ID (ENVIRONMENT=test).
REDIS_TEST_NAMESPACE=test
# Initialize .env without displaying secrets: python scripts/init-auth-env.py
# The placeholders below are deliberately rejected at startup.
AUTH_JWT_SECRET=replace-with-distinct-random-secret-at-least-32-bytes
AUTH_RATE_LIMIT_SECRET=replace-with-another-random-secret-at-least-32-bytes
AUTH_TRUSTED_ORIGINS=["http://localhost:3000"]
AUTH_COOKIE_SECURE=false
# Browser-visible auth path: use /backend/auth behind a /backend gateway.
AUTH_REFRESH_COOKIE_PATH=/auth
AUTH_JWT_ISSUER=restaurantos
AUTH_JWT_AUDIENCE=restaurantos-browser
AUTH_ACCESS_SECONDS=600
AUTH_SESSION_SECONDS=604800
AUTH_TRUSTED_PROXY_IPS=[]
AUTH_LOGIN_EMAIL_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_LOGIN_IP_WINDOW_SECONDS=900
AUTH_REFRESH_FAMILY_LIMIT=10
AUTH_REFRESH_IP_LIMIT=100
AUTH_REFRESH_WINDOW_SECONDS=60
# Finite process-local outage cap; production sizing must be measured.
AUTH_LOCAL_MAX_ENTRIES=10000

# Tests truncate their target database before and after every test. The test
# harness rejects database names that do not end in "_test".
TEST_DATABASE_URL=postgresql+asyncpg://restaurantos:restaurantos@localhost:5433/restaurantos_test  # pragma: allowlist secret
