# Local-development database URL. These are Docker Compose defaults only.
# Do not reuse these credentials outside a local development environment.
DATABASE_URL=postgresql+asyncpg://restaurantos:restaurantos@localhost:5433/restaurantos  # pragma: allowlist secret
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_ECHO=false
# Optional infrastructure; startup and /health do not require Redis availability.
REDIS_URL=redis://localhost:6379/0
REDIS_OPERATION_BUDGET_MS=100
REDIS_MAX_CONNECTIONS=20
# Validation overrides this with a unique owned run ID (ENVIRONMENT=test).
REDIS_TEST_NAMESPACE=test
# Initialize .env without displaying secrets: python scripts/init-auth-env.py
# The placeholders below are deliberately rejected at startup.
AUTH_JWT_SECRET=replace-with-distinct-random-secret-at-least-32-bytes
AUTH_RATE_LIMIT_SECRET=replace-with-another-random-secret-at-least-32-bytes
AUTH_TRUSTED_ORIGINS=["http://localhost:3000"]
AUTH_COOKIE_SECURE=false
AUTH_JWT_ISSUER=restaurantos
AUTH_JWT_AUDIENCE=restaurantos-browser
AUTH_ACCESS_SECONDS=600
AUTH_SESSION_SECONDS=604800
AUTH_TRUSTED_PROXY_IPS=[]
AUTH_LOGIN_EMAIL_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REFRESH_FAMILY_LIMIT=30
AUTH_REFRESH_IP_LIMIT=120
AUTH_REFRESH_WINDOW_SECONDS=60

# Tests truncate their target database before and after every test. The test
# harness rejects database names that do not end in "_test".
TEST_DATABASE_URL=postgresql+asyncpg://restaurantos:restaurantos@localhost:5433/restaurantos_test  # pragma: allowlist secret
