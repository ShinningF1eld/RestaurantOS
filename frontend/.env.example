# Use the same hostname as the web app so host-only cookies reach SSR.
# For a same-host gateway stripping /backend, build with /backend instead.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional private server-side API origin; never exposed to browser bundles.
API_URL=http://localhost:8000

# Optional server-only tracing; container endpoint: http://collector:4318.
MONITORING_ENABLED=false
MONITORING_ENDPOINT=http://localhost:4318
MONITORING_EXPORT_TIMEOUT_MS=1000
MONITORING_QUEUE_SIZE=256
MONITORING_SHUTDOWN_MS=3000
