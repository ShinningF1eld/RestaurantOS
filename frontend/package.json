{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern \"coverage/**\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\"",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "validate": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:client:coverage": "vitest run --coverage --coverage.reportsDirectory=coverage/client tests/client",
    "test:component:coverage": "vitest run --coverage --coverage.reportsDirectory=coverage/component tests/component",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "29.1.0",
    "prettier": "3.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
