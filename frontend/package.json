{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\"",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "validate": "npm run lint && npm run typecheck && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
